# SQLite locally (file:./hystlovers.db); a postgres:// URL switches adapters automatically
DATABASE_URI=file:./hystlovers.db

# Docker: login of the db service. docker-compose builds the app's DATABASE_URI
# from these, so DATABASE_URI above only applies outside Docker. Keep the
# password URL-safe, e.g. `openssl rand -hex 24`.
POSTGRES_USER=hystlovers
POSTGRES_PASSWORD=
POSTGRES_DB=hystlovers
# Docker: host port nginx proxies to; bound to 127.0.0.1 only.
APP_PORT=3000
# docker-compose-dev.yml: host ports of the app and its Postgres.
DEV_PORT=3000
DEV_DB_PORT=5433

# Encrypts Payload's JWT and cookies — generate a long random string per environment
PAYLOAD_SECRET=

# Public origin. Payload also uses it as the CSRF origin, so it must match where
# the app is served or server actions will not see the signed-in shopper.
SERVER_URL=http://localhost:3000

# Leave SMTP_HOST empty in development: Payload then prints emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@hystlovers.com
SMTP_FROM_NAME=Hystlovers

# Created on the first `npm run seed`. In a production build the admin is only
# created when ADMIN_PASSWORD is set; otherwise sign up on /admin.
ADMIN_EMAIL=admin@hystlovers.com
ADMIN_PASSWORD=

# Vercel only: set automatically once a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
